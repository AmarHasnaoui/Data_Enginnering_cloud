{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Step Function pipeline extraction air quality vers S3 Bronze",
  "Resources": {
    "AirQualityStateMachine": {
      "Type": "AWS::StepFunctions::StateMachine",
      "Properties": {
        "StateMachineName": "projet-efrei-pipeline",
        "RoleArn": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/projet-efrei-role"
        },
        "DefinitionS3Location": {
          "Bucket": "s3-projet-efrei",
          "Key": "stepfunction/code_step.json"
        },
        "DefinitionSubstitutions": {
          "LambdaExtractionArn": {
            "Fn::Sub": "arn:aws:lambda:eu-west-3:${AWS::AccountId}:function:projet-efrei-extraction"
          }
        }
      }
    }
  }
}
