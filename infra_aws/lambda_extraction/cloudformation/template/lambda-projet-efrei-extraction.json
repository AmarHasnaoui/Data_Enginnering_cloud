{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Lambda d'extraction API LCSQA → S3 Bronze",
  "Resources": {
    "ExtractionLambdaFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": "projet-efrei-extraction",
        "Code": {
          "S3Bucket": "s3-projet-efrei",
          "S3Key": "lambda/extraction.zip"
        },
        "Runtime": "python3.12",
        "Handler": "lambda_function.lambda_handler",
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/projet-efrei-role"
        },
        "Timeout": 300,
        "MemorySize": 256,
        "Layers": [
          { "Fn::Sub": "arn:aws:lambda:eu-west-3:${AWS::AccountId}:layer:RequestsLayer:2" }
        ],
        "Environment": {
          "Variables": {
            "BUCKET": "s3-projet-efrei"
          }
        },
        "Tags": [
          { "Key": "Project", "Value": "ProjetEfrei" },
          { "Key": "Function", "Value": "Extraction" }
        ]
      }
    }
  }
}
