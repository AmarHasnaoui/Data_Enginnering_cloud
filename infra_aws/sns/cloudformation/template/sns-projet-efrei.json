{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "SNS alertes NovaSight — Step Functions FAILED + Lambda Import Errors",
  "Resources": {

    "AlertsTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "novasight-alerts",
        "Tags": [{ "Key": "Project", "Value": "ProjetEfrei" }]
      }
    },

    "AlertsEmailSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Properties": {
        "TopicArn": { "Ref": "AlertsTopic" },
        "Protocol": "email",
        "Endpoint": "amarhasnaoui2019@gmail.com"
      }
    },

    "AlertsTopicPolicy": {
      "Type": "AWS::SNS::TopicPolicy",
      "Properties": {
        "Topics": [{ "Ref": "AlertsTopic" }],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AllowEventBridgePublish",
              "Effect": "Allow",
              "Principal": { "Service": "events.amazonaws.com" },
              "Action": "sns:Publish",
              "Resource": { "Ref": "AlertsTopic" }
            },
            {
              "Sid": "AllowCloudWatchPublish",
              "Effect": "Allow",
              "Principal": { "Service": "cloudwatch.amazonaws.com" },
              "Action": "sns:Publish",
              "Resource": { "Ref": "AlertsTopic" }
            }
          ]
        }
      }
    },

    "StepFunctionsFailedRule": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Name": "novasight-stepfunctions-failed",
        "Description": "Alerte email si l'extraction Step Functions projet-efrei-pipeline échoue",
        "EventPattern": {
          "source": ["aws.states"],
          "detail-type": ["Step Functions Execution Status Change"],
          "detail": {
            "status": ["FAILED", "TIMED_OUT", "ABORTED"],
            "stateMachineArn": [{ "Fn::Sub": "arn:aws:states:eu-west-3:${AWS::AccountId}:stateMachine:projet-efrei-pipeline" }]
          }
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "SNSAlertTarget",
            "Arn": { "Ref": "AlertsTopic" },
            "InputTransformer": {
              "InputPathsMap": {
                "execution": "$.detail.executionArn",
                "status":    "$.detail.status",
                "cause":     "$.detail.cause",
                "time":      "$.time"
              },
              "InputTemplate": "\"[NovaSight ALERTE] Step Functions FAILED\\nStateMachine : projet-efrei-pipeline\\nExecution    : <execution>\\nStatut       : <status>\\nHeure        : <time>\\nCause        : <cause>\""
            }
          }
        ]
      }
    },

    "LambdaRdsImportErrorAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "novasight-lambda-rds-import-errors",
        "AlarmDescription": "Alerte si la Lambda RDS Import retourne une erreur",
        "Namespace": "AWS/Lambda",
        "MetricName": "Errors",
        "Dimensions": [
          { "Name": "FunctionName", "Value": "lambda-projet-efrei-rds-import" }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [{ "Ref": "AlertsTopic" }]
      }
    }

  },
  "Outputs": {
    "AlertsTopicArn": {
      "Value": { "Ref": "AlertsTopic" },
      "Export": { "Name": "projet-efrei-sns-alerts-arn" }
    }
  }
}